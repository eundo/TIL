---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import ProjectRow from "../../../components/ProjectRow.astro";
import { getProjects } from "../../../lib/content";
import { Search } from "lucide-react";
const projects = await getProjects();
---

<BaseLayout
  title="Projects"
  section="projects"
  description="박은도가 직접 만든 프로젝트. 실제 화면, 사용 흐름과 구현 기록."
>
  <header class="page-heading container">
    <h1>
      Projects <span>{projects.length}</span>
    </h1>
    <p>직접 쓰려고 만든 것들.</p>
  </header>
  <section class="container" aria-label="프로젝트 목록">
    <div class="project-toolbar">
      <label class="project-search">
        <Search size={18} />
        <span class="sr-only">프로젝트 검색</span>
        <input
          id="project-search"
          type="search"
          placeholder="이름, 기술로 검색"
          autocomplete="off"
        />
      </label>
      <label class="project-sort">
        <span class="sr-only">정렬</span>
        <select id="project-sort">
          <option value="order">선택 순서</option>
          <option value="recent">최근 업데이트</option>
          <option value="name">이름순</option>
        </select>
      </label>
      <span id="project-count" aria-live="polite">
        {projects.length} projects
      </span>
    </div>
    <div id="project-list">
      {projects.map((project, index) => (
        <div
          data-project-item
          data-order={project.order}
          data-updated={project.updated}
          data-name={project.title}
        >
          <ProjectRow project={project} index={index} />
        </div>
      ))}
    </div>
    <p class="empty-message" id="project-empty" hidden>
      검색 결과가 없습니다.
    </p>
  </section>
</BaseLayout>
<script>
  const input = document.querySelector<HTMLInputElement>("#project-search")!;
  const list = document.querySelector<HTMLElement>("#project-list")!;
  const items = [...list.querySelectorAll<HTMLElement>("[data-project-item]")];
  input.addEventListener("input", () => {
    const query = input.value.trim().toLocaleLowerCase("ko");
    let count = 0;
    items.forEach((item) => {
      item.hidden = !item
        .querySelector<HTMLElement>("[data-project-row]")!
        .dataset.search!.includes(query);
      if (!item.hidden) count++;
    });
    document.querySelector("#project-count")!.textContent = `${count} projects`;
    document.querySelector<HTMLElement>("#project-empty")!.hidden = count > 0;
  });
  document
    .querySelector<HTMLSelectElement>("#project-sort")!
    .addEventListener("change", (event) => {
      const value = (event.target as HTMLSelectElement).value;
      items.sort((a, b) =>
        value === "recent"
          ? b.dataset.updated!.localeCompare(a.dataset.updated!)
          : value === "name"
            ? a.dataset.name!.localeCompare(b.dataset.name!)
            : Number(a.dataset.order) - Number(b.dataset.order),
      );
      items.forEach((item) => list.append(item));
    });
</script>
<style>
  .page-heading h1 span {
    font-size: 18px;
    font-weight: 500;
    vertical-align: super;
    color: var(--muted);
  }
  .project-toolbar {
    display: flex;
    align-items: center;
    gap: 20px;
    padding: 0 0 26px;
    flex-wrap: wrap;
  }
  .project-search {
    display: flex;
    align-items: center;
    gap: 10px;
    border-bottom: 1px solid var(--line);
    height: 44px;
    min-width: 240px;
  }
  .project-search input {
    border: 0;
    outline: none;
    min-width: 0;
    width: 100%;
    height: 42px;
    background: transparent;
    font-size: 14px;
  }
  .project-sort select {
    border: 1px solid var(--line);
    background: #fff;
    padding: 10px;
    font-size: 13px;
    border-radius: 4px;
    min-height: 44px;
  }
  #project-count {
    margin-left: auto;
    font-size: 12px;
    color: var(--muted);
  }
  @media (max-width: 760px) {
    .project-toolbar {
      gap: 14px;
    }
    .project-search {
      width: 100%;
    }
  }
</style>
