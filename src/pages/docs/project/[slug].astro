---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import ScreenGallery from "../../../components/ScreenGallery";
import TableOfContents from "../../../components/TableOfContents.astro";
import { ArrowLeft, ArrowUpRight } from "lucide-react";
import { getProjects } from "../../../lib/content";
export async function getStaticPaths() {
  return (await getCollection("projects", ({ data }) => data.published)).map(
    (entry) => ({ params: { slug: entry.id }, props: { entry } }),
  );
}
const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const project = entry.data;
const projects = await getProjects();
const index = projects.findIndex((item) => item.id === entry.id);
const next = projects[(index + 1) % projects.length];
---

<BaseLayout
  title={project.title}
  description={project.description}
  image={project.cover?.src}
  section="projects"
>
  <header class="page-heading container project-heading">
    <a class="back-link" href="/docs/project/">
      <ArrowLeft size={16} />
      Projects
    </a>
    <h1>{project.title}</h1>
    <p>{project.summary}</p>
    <div class="project-info">
      <div class="meta">
        <span>{project.stack.join(" / ")}</span>
        <span>
          {project.stage} · {project.visibility}
        </span>
        <time
          datetime={project.updated}
          title="검토한 소스의 최신 커밋 날짜 (Asia/Seoul)"
        >
          {project.updated.replaceAll("-", ".")}
        </time>
      </div>
      {project.demo && (
        <a
          class="text-link"
          href={project.demo}
          target="_blank"
          rel="noopener noreferrer"
        >
          플레이
          <ArrowUpRight size={18} />
        </a>
      )}
    </div>
    <p class="source-note">
      {project.repository} · 소스 확인{" "}
      <time datetime={project.reviewed}>
        {project.reviewed.replaceAll("-", ".")}
      </time>
    </p>
  </header>
  {project.gallery.length > 0 && (
    <ScreenGallery
      steps={project.gallery}
      title={project.title}
      layout={project.presentation}
      client:visible
    />
  )}
  <div class="container">
    <div class="article-grid">
      <article>
        <TableOfContents headings={headings} mobile />
        <div class="prose">
          <Content />
        </div>
      </article>
      <TableOfContents headings={headings} />
    </div>
    <nav class="next-project" aria-label="다음 프로젝트">
      <span>다음 프로젝트</span>
      <a href={next.href}>
        {next.title}
        <ArrowUpRight size={25} />
      </a>
    </nav>
  </div>
</BaseLayout>
<style>
  .project-heading {
    padding-block: 36px 28px;
  }
  .project-heading .back-link {
    margin-bottom: 16px;
  }
  .project-heading p {
    max-width: 780px;
  }
  .project-heading .source-note {
    margin-top: 14px;
    font-size: 12px;
    line-height: 1.7;
    color: var(--muted);
    overflow-wrap: anywhere;
  }
  .project-info {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    margin-top: 24px;
  }
  .next-project {
    border-top: 1px solid var(--line);
    margin-top: 60px;
    padding-top: 28px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 24px;
  }
  .next-project > span {
    font-size: 13px;
    color: var(--muted);
  }
  .next-project > a {
    display: flex;
    align-items: center;
    gap: 20px;
    font-size: 26px;
    font-weight: 600;
  }
  @media (max-width: 760px) {
    .project-info {
      align-items: flex-start;
      flex-direction: column;
      gap: 18px;
    }
    .project-info .meta {
      font-size: 12px;
      line-height: 1.7;
    }
    .next-project > a {
      font-size: 20px;
    }
    .next-project {
      align-items: flex-start;
    }
    .project-heading h1 {
      font-size: 37px;
    }
  }
</style>
