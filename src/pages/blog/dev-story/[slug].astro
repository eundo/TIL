---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import TableOfContents from "../../../components/TableOfContents.astro";
import { ArrowLeft } from "lucide-react";
export async function getStaticPaths() {
  return (await getCollection("stories", ({ data }) => data.published)).map(
    (entry) => ({ params: { slug: entry.id }, props: { entry } }),
  );
}
const { entry } = Astro.props;
const { Content, headings } = await render(entry);
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.description}
  section="stories"
>
  <header class="page-heading container">
    <a class="back-link" href="/blog/dev-story">
      <ArrowLeft size={16} />
      Stories
    </a>
    <h1>{entry.data.title}</h1>
    <p>{entry.data.description}</p>
    <div class="story-meta meta">
      <span>박은도</span>
      {entry.data.tags.map((tag) => (
        <a href={`/blog/tags/${tag.toLowerCase().replaceAll(" ", "-")}`}>
          {tag}
        </a>
      ))}
    </div>
  </header>
  <div class="container">
    <div class="article-grid">
      <article>
        <TableOfContents headings={headings} mobile />
        <div class="prose">
          <Content />
        </div>
      </article>
      <TableOfContents headings={headings} />
    </div>
  </div>
</BaseLayout>
<style>
  .story-meta {
    margin-top: 20px;
  }
  .page-heading h1 {
    font-size: 46px;
    max-width: 950px;
  }
  @media (max-width: 760px) {
    .page-heading h1 {
      font-size: 33px;
    }
  }
</style>
